(defmacro when (test &body body)
  `(if ,test (block ,@body) nil))

(defmacro unless (test &body body)
  `(if ,test nil (block ,@body)))

(defmacro progn (&body body)
  `(block ,@body))

; CL-style spellings of the Nim declaration forms — plain aliases, not the
; canonical syntax (which stays Nim-focused); provided for readers who'd
; rather see a `def...` prefix.
(defmacro defproc (name &rest args)
  `(proc ,name ,@args))

(defmacro defun (name &rest args)
  `(proc ,name ,@args))

(defmacro defvar (name &rest args)
  `(var ,name ,@args))

; `defvar`/`defparameter` are the same plain `var` alias at expansion time —
; both compile down to nothing but `(var name args...)`. Their distinct CL
; semantics (defvar sets only if unbound; defparameter always resets) are
; not a macro-expansion-time property; they only become observable when the
; same name is re-entered, which only happens in `lfn repl` (#14), so the
; REPL — not this macro — is what tells the two apart, by checking a
; re-entered name's *raw* head symbol before deciding whether to keep the
; old value or replace it.
(defmacro defparameter (name &rest args)
  `(var ,name ,@args))

(defmacro defconst (name &rest args)
  `(const ,name ,@args))

(defmacro defconstant (name &rest args)
  `(const ,name ,@args))

(defmacro deftype (name &rest args)
  `(type ,name ,@args))

(defmacro deftemplate (name &rest args)
  `(template ,name ,@args))

(defmacro defiterator (name &rest args)
  `(iterator ,name ,@args))

(defmacro defmethod (name &rest args)
  `(method ,name ,@args))

(defmacro deffunc (name &rest args)
  `(func ,name ,@args))

(defmacro defconverter (name &rest args)
  `(converter ,name ,@args))

(defmacro and (&rest args)
  (if (nil? args)
      true
      (if (nil? (rest args))
          (first args)
          `(if ,(first args) (and ,@(rest args)) false))))

(defmacro or (&rest args)
  (if (nil? args)
      false
      (if (nil? (rest args))
          (first args)
          (let ((value (gensym "or")))
            `(let ((,value ,(first args)))
               (if ,value ,value (or ,@(rest args))))))))

(defmacro cond (&rest clauses)
  (if (nil? clauses)
      nil
      (let ((clause (first clauses)))
        (if (symbol? clause)
            (macro-error "cond clause must be a list")
            (if (nil? (rest clause))
                (macro-error "cond clause expects test and body")
                (if (nil? (rest clauses))
                    `(if ,(first clause) (block ,@(rest clause)) nil)
                    `(if ,(first clause) (block ,@(rest clause)) (cond ,@(rest clauses)))))))))

(defmacro let* (bindings &body body)
  (if (nil? bindings)
      `(block ,@body)
      `(let (,(first bindings)) (let* ,(rest bindings) ,@body))))

(defmacro first (items)
  `(at ,items 0))

(defmacro rest (items)
  `(slice ,items 1 (- (. ,items len) 1)))

(defmacro empty? (items)
  `(== (. ,items len) 0))

(defmacro append (left right)
  `(& ,left ,right))

(defmacro map (items op)
  `(lfnSeqMap ,items ,op))

(defmacro filter (items pred)
  `(lfnSeqFilter ,items ,pred))

(defmacro foldl (items initial op)
  `(lfnSeqFoldl ,items ,initial ,op))

(defmacro foldr (items initial op)
  `(lfnSeqFoldr ,items ,initial ,op))

; CL-style sequence functions. Argument order follows the rest of this
; preamble (items first, like map/filter/foldl above) rather than CL's own
; order (e.g. CL's `some`/`every` take the predicate first) — kept
; consistent with LFN's own convention instead of literal CL. `position`
; and `lfnSeqPosition` return -1 when not found (Nim's own sentinel
; convention), not CL's nil, since a generic element type has no nil-like
; value to return instead.
; unlike CL, `n` and `fill` are both required — Nim can only infer the
; array's element type from an actual argument value, and LFN has no call-
; site syntax for supplying a bare type argument instead.
(defmacro make-array (n fill)
  `(lfnMakeArray ,n ,fill))

(defmacro length (items)
  `(. ,items len))

(defmacro reverse (items)
  `(lfnReversed ,items))

(defmacro sort (items)
  `(lfnSorted ,items))

(defmacro mapcar (items op)
  `(lfnSeqMap ,items ,op))

(defmacro reduce (items initial op)
  `(lfnSeqFoldl ,items ,initial ,op))

(defmacro remove-if (items pred)
  `(lfnSeqRemoveIf ,items ,pred))

(defmacro remove-if-not (items pred)
  `(lfnSeqFilter ,items ,pred))

(defmacro count-if (items pred)
  `(lfnSeqCount ,items ,pred))

(defmacro some (items pred)
  `(lfnSeqAny ,items ,pred))

(defmacro every (items pred)
  `(lfnSeqEvery ,items ,pred))

(defmacro position (items value)
  `(lfnSeqPosition ,items ,value))

(defmacro elt (items i)
  `(at ,items ,i))

(defmacro aref (items i)
  `(at ,items ,i))

; CL's subseq takes an exclusive end (and an optional, sequence-length-
; defaulted one) — unlike LFN's own `slice`, whose end is inclusive — so
; this isn't a bare alias, it adjusts for that difference.
(defmacro subseq (items start &rest rest)
  (if (nil? rest)
      `(slice ,items ,start (- (. ,items len) 1))
      `(slice ,items ,start (- ,(first rest) 1))))

(defmacro -> (value &rest forms)
  (if (nil? forms)
      value
      (let ((form (first forms)))
        (if (list? form)
            `(-> (,(first form) ,value ,@(rest form)) ,@(rest forms))
            `(-> (,form ,value) ,@(rest forms))))))

(defmacro ->> (value &rest forms)
  (if (nil? forms)
      value
      (let ((form (first forms)))
        (if (list? form)
            `(->> (,(first form) ,@(rest form) ,value) ,@(rest forms))
            `(->> (,form ,value) ,@(rest forms))))))

(defmacro as-> (value name &body forms)
  (if (nil? forms)
      value
      `(let ((,name ,value)) (as-> ,(first forms) ,name ,@(rest forms)))))

; CLOS-lite: a defclass/make-instance layer over the existing type/ref/
; object/new/method forms, in the spirit of the def* aliases and CL sequence
; functions above. Deliberate departures from real CLOS, tightened by what
; LFN doesn't have yet (see the tracker for the follow-up tickets):
;   - :initform is supported (a slot default used when make-instance omits
;     it). :initarg (a distinct external initializer name for a slot,
;     `(name Type :initarg :nom)`) is also supported, but not by a
;     macro-expand-time class registry — defclass still has no visibility
;     into an inherited superclass's slots at its own expansion time.
;     Instead each :initarg is recorded as a Nim custom field pragma
;     (`lfnInitarg`, runtime.nim), and `make-instance` expands to the Nim
;     macro `lfnMakeInstance`, which walks the class's type definition —
;     including its `of` inheritance chain — at Nim semcheck time, when
;     every ancestor's fields and pragmas are visible. A slot's own field
;     name and its :initarg are both accepted at the call site — an
;     :initarg is an alias, not a rename: `(name Type :initarg :nom)` can
;     be initialized as either `(name ...)` or `(nom ...)`.
;   - :accessor generates both a getter and a setter (`animalName` and
;     `animalName=`, callable as `(set! (animalName a) v)`); :reader
;     generates a getter only.
;   - single inheritance only — a defclass superclass list may name at most
;     one parent; full CLOS multiple dispatch is tracked separately.
;   - defmethod stays the plain `method` alias defined above; CLOS-lite adds
;     no dispatch mechanism of its own.
;   - every slot carries an explicit Nim type, because Nim object fields
;     must be typed and LFN has no type-inference story for them.
;   - :accessor/:reader names become real `proc` names, so — unlike a
;     defclass/defmacro/defmacro-proc name itself, which only ever exists at
;     expansion time — they must be plain Nim identifiers (no hyphens);
;     `animalName`, not `animal-name`.
;   - an :initform expression must be a compile-time-evaluable Nim
;     expression — it lowers straight into a Nim object-field default (see
;     `man/language-reference.md`), which carries that same restriction.
;   - an :initarg value is conventionally keyword-shaped (`:nom`), matching
;     :accessor/:reader/:initform's own keys, but any symbol works — it
;     never becomes a proc name, only a Nim pragma string, so it carries
;     none of :accessor/:reader's plain-Nim-identifier restriction.

(defmacro-proc lfn-class-parent (supers)
  (if (nil? supers)
      'RootObj
      (if (nil? (rest supers))
          (first supers)
          (macro-error "defclass supports a single superclass; see the multiple-dispatch ticket"))))

(defmacro-proc lfn-slot-option-key-ok? (key)
  (if (= key ':accessor) true (if (= key ':reader) true (if (= key ':initform) true (= key ':initarg)))))

(defmacro-proc lfn-validate-slot-options (opts)
  (if (nil? opts)
      nil
      (if (nil? (rest opts))
          (macro-error "defclass slot option missing its value")
          (if (lfn-slot-option-key-ok? (first opts))
              ; :initform's value is an arbitrary expression; :accessor/
              ; :reader/:initarg still require a plain symbol (:accessor/
              ; :reader turn it into a proc name; :initarg turns it into a
              ; pragma string — see lfn-slot-initarg/lfn-slot-field).
              (if (= (first opts) ':initform)
                  (lfn-validate-slot-options (rest (rest opts)))
                  (if (symbol? (nth opts 1))
                      (lfn-validate-slot-options (rest (rest opts)))
                      (macro-error "defclass slot accessor/reader/initarg value must be a symbol")))
              (macro-error (string-append "defclass: unknown slot option " (symbol->string (first opts))))))))

(defmacro-proc lfn-slot-names-for-key (opts key)
  ; Collects the values paired with a given option key (`:accessor`,
  ; `:reader`, or `:initform`), skipping every other key/value pair. Called
  ; once per key so `:accessor` and `:reader` each generate their own set of
  ; procs (see #75).
  (if (nil? opts)
      '()
      (if (= (first opts) key)
          (cons (nth opts 1) (lfn-slot-names-for-key (rest (rest opts)) key))
          (lfn-slot-names-for-key (rest (rest opts)) key))))

(defmacro-proc lfn-slot-initform (slot)
  ; Extracts a slot's :initform value, if any — the single value paired with
  ; the :initform key, or nil if the option is absent. More than one
  ; :initform on a slot is rejected here, since `lfn-validate-slot-options`
  ; validates each key/value pair independently and never counts repeats.
  (let ((initforms (lfn-slot-names-for-key (rest (rest slot)) ':initform)))
    (if (nil? initforms)
        nil
        (if (nil? (rest initforms))
            (first initforms)
            (macro-error "defclass slot has more than one :initform")))))

(defmacro-proc lfn-slot-initarg (slot)
  ; Extracts a slot's :initarg value, if any — the single value paired with
  ; the :initarg key, or nil if the option is absent. More than one
  ; :initarg on a slot is rejected here, mirroring lfn-slot-initform.
  (let ((initargs (lfn-slot-names-for-key (rest (rest slot)) ':initarg)))
    (if (nil? initargs)
        nil
        (if (nil? (rest initargs))
            (first initargs)
            (macro-error "defclass slot has more than one :initarg")))))

(defmacro-proc lfn-slot-field (slot)
  ; Validated here, not only in lfn-slot-accessors: defclass computes
  ; `fields` before `accessors` (see below), and an :initarg's value gets
  ; converted with symbol->string right below — which needs it to already
  ; be a symbol, not just eventually rejected as a non-symbol once
  ; lfn-slot-accessors gets around to validating it.
  (if (not (list? slot))
      (macro-error "defclass slot must be a list")
      (if (< (length slot) 2)
          (macro-error "defclass slot must be (name Type [options...])")
          (let ((validated (lfn-validate-slot-options (rest (rest slot))))
                (initform (lfn-slot-initform slot))
                (initarg (lfn-slot-initarg slot)))
            (if (nil? initarg)
                (if (nil? initform)
                    (list (first slot) (nth slot 1))
                    (list (first slot) (nth slot 1) initform))
                ; An :initarg becomes a field pragma (`lfnInitarg`,
                ; runtime.nim) that `lfnMakeInstance` reads back off the
                ; class's Nim type definition at semcheck time — the
                ; visibility a macro-expand-time defclass/make-instance
                ; pair can't have across an inherited slot. The pragma's
                ; string carries the keyword's own text (colon included);
                ; lfnMakeInstance strips it there, not here, since LFN's
                ; macro-time builtins have no substring primitive.
                (let ((pragmaClause `(pragma (: lfnInitarg ,(symbol->string initarg)))))
                  (if (nil? initform)
                      (list (first slot) pragmaClause (nth slot 1))
                      (list (first slot) pragmaClause (nth slot 1) initform))))))))

(defmacro-proc lfn-slot-fields (slots)
  (if (nil? slots)
      '()
      (cons (lfn-slot-field (first slots)) (lfn-slot-fields (rest slots)))))

(defmacro-proc lfn-make-getter (className fieldName fieldType getterName)
  ; A literal `self`, not `(gensym "self")` — the automatic hygiene pass
  ; auto-renames a proc's own literal param names, so this can't capture or
  ; be captured by a caller symbol even without an explicit gensym. (A
  ; literal name also keeps the golden-expansion fixture's output stable —
  ; renderSyntax doesn't print hygieneId, but a gensym'd name would embed
  ; the macro env's running counter in its printed spelling, making the
  ; fixture's exact text depend on unrelated preamble changes.)
  `(proc ,getterName ((self ,className)) (: ,fieldType) (. self ,fieldName)))

(defmacro-proc lfn-make-setter (className fieldName fieldType setterName)
  `(proc ,setterName ((self ,className) (v ,fieldType)) (set! (. self ,fieldName) v)))

(defmacro-proc lfn-make-getters-for-names (className fieldName fieldType names)
  (if (nil? names)
      '()
      (cons (lfn-make-getter className fieldName fieldType (first names))
            (lfn-make-getters-for-names className fieldName fieldType (rest names)))))

(defmacro-proc lfn-setter-name (accessorName)
  (string->symbol (string-append (symbol->string accessorName) "=")))

(defmacro-proc lfn-make-setters-for-names (className fieldName fieldType names)
  (if (nil? names)
      '()
      (cons (lfn-make-setter className fieldName fieldType (lfn-setter-name (first names)))
            (lfn-make-setters-for-names className fieldName fieldType (rest names)))))

(defmacro-proc lfn-slot-accessors (className slot)
  (let ((fieldName (first slot))
        (fieldType (nth slot 1))
        (opts (rest (rest slot))))
    (lfn-validate-slot-options opts)
    (let ((accessorNames (lfn-slot-names-for-key opts ':accessor))
          (readerNames (lfn-slot-names-for-key opts ':reader)))
      (append (lfn-make-getters-for-names className fieldName fieldType accessorNames)
              (append (lfn-make-setters-for-names className fieldName fieldType accessorNames)
                      (lfn-make-getters-for-names className fieldName fieldType readerNames))))))

(defmacro-proc lfn-class-accessors (className slots)
  (if (nil? slots)
      '()
      (append (lfn-slot-accessors className (first slots)) (lfn-class-accessors className (rest slots)))))

(defmacro defclass (name supers slots)
  (let ((fields (lfn-slot-fields slots))
        (accessors (lfn-class-accessors name slots))
        (parent (lfn-class-parent supers)))
    `(block
       (type ,name (ref (object (of ,parent) ,@fields)))
       ,@accessors)))

(defmacro make-instance (className &rest inits)
  ; lfnMakeInstance (runtime.nim) is a Nim macro, not plain sugar over `new`:
  ; unlike this preamble macro, it runs at Nim semcheck time, when the
  ; class's whole `of` inheritance chain — and every ancestor's :initarg
  ; pragmas — is visible, so an initializer can name either a slot's own
  ; field or its :initarg, inherited or not.
  `(lfnMakeInstance ,className ,@inits))
