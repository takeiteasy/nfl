(defmacro when (test &body body)
  `(if ,test (block ,@body) nil))

(defmacro unless (test &body body)
  `(if ,test nil (block ,@body)))

(defmacro progn (&body body)
  `(block ,@body))

; CL-style spellings of the Nim declaration forms — plain aliases, not the
; canonical syntax (which stays Nim-focused); provided for readers who'd
; rather see a `def...` prefix.
(defmacro defproc (name &rest args)
  `(proc ,name ,@args))

(defmacro defun (name &rest args)
  `(proc ,name ,@args))

(defmacro defvar (name &rest args)
  `(var ,name ,@args))

(defmacro defconst (name &rest args)
  `(const ,name ,@args))

(defmacro defconstant (name &rest args)
  `(const ,name ,@args))

(defmacro deftype (name &rest args)
  `(type ,name ,@args))

(defmacro deftemplate (name &rest args)
  `(template ,name ,@args))

(defmacro defiterator (name &rest args)
  `(iterator ,name ,@args))

(defmacro defmethod (name &rest args)
  `(method ,name ,@args))

(defmacro deffunc (name &rest args)
  `(func ,name ,@args))

(defmacro defconverter (name &rest args)
  `(converter ,name ,@args))

(defmacro and (&rest args)
  (if (nil? args)
      true
      (if (nil? (rest args))
          (first args)
          `(if ,(first args) (and ,@(rest args)) false))))

(defmacro or (&rest args)
  (if (nil? args)
      false
      (if (nil? (rest args))
          (first args)
          (let ((value (gensym "or")))
            `(let ((,value ,(first args)))
               (if ,value ,value (or ,@(rest args))))))))

(defmacro cond (&rest clauses)
  (if (nil? clauses)
      nil
      (let ((clause (first clauses)))
        (if (symbol? clause)
            (macro-error "cond clause must be a list")
            (if (nil? (rest clause))
                (macro-error "cond clause expects test and body")
                (if (nil? (rest clauses))
                    `(if ,(first clause) (block ,@(rest clause)) nil)
                    `(if ,(first clause) (block ,@(rest clause)) (cond ,@(rest clauses)))))))))

(defmacro let* (bindings &body body)
  (if (nil? bindings)
      `(block ,@body)
      `(let (,(first bindings)) (let* ,(rest bindings) ,@body))))

(defmacro first (items)
  `(at ,items 0))

(defmacro rest (items)
  `(slice ,items 1 (- (. ,items len) 1)))

(defmacro empty? (items)
  `(== (. ,items len) 0))

(defmacro append (left right)
  `(& ,left ,right))

(defmacro map (items op)
  `(nflSeqMap ,items ,op))

(defmacro filter (items pred)
  `(nflSeqFilter ,items ,pred))

(defmacro foldl (items initial op)
  `(nflSeqFoldl ,items ,initial ,op))

(defmacro foldr (items initial op)
  `(nflSeqFoldr ,items ,initial ,op))

; CL-style sequence functions. Argument order follows the rest of this
; preamble (items first, like map/filter/foldl above) rather than CL's own
; order (e.g. CL's `some`/`every` take the predicate first) — kept
; consistent with NFL's own convention instead of literal CL. `position`
; and `nflSeqPosition` return -1 when not found (Nim's own sentinel
; convention), not CL's nil, since a generic element type has no nil-like
; value to return instead.
; unlike CL, `n` and `fill` are both required — Nim can only infer the
; array's element type from an actual argument value, and NFL has no call-
; site syntax for supplying a bare type argument instead.
(defmacro make-array (n fill)
  `(nflMakeArray ,n ,fill))

(defmacro length (items)
  `(. ,items len))

(defmacro reverse (items)
  `(nflReversed ,items))

(defmacro sort (items)
  `(nflSorted ,items))

(defmacro mapcar (items op)
  `(nflSeqMap ,items ,op))

(defmacro reduce (items initial op)
  `(nflSeqFoldl ,items ,initial ,op))

(defmacro remove-if (items pred)
  `(nflSeqRemoveIf ,items ,pred))

(defmacro remove-if-not (items pred)
  `(nflSeqFilter ,items ,pred))

(defmacro count-if (items pred)
  `(nflSeqCount ,items ,pred))

(defmacro some (items pred)
  `(nflSeqAny ,items ,pred))

(defmacro every (items pred)
  `(nflSeqEvery ,items ,pred))

(defmacro position (items value)
  `(nflSeqPosition ,items ,value))

(defmacro elt (items i)
  `(at ,items ,i))

(defmacro aref (items i)
  `(at ,items ,i))

; CL's subseq takes an exclusive end (and an optional, sequence-length-
; defaulted one) — unlike NFL's own `slice`, whose end is inclusive — so
; this isn't a bare alias, it adjusts for that difference.
(defmacro subseq (items start &rest rest)
  (if (nil? rest)
      `(slice ,items ,start (- (. ,items len) 1))
      `(slice ,items ,start (- ,(first rest) 1))))

(defmacro -> (value &rest forms)
  (if (nil? forms)
      value
      (let ((form (first forms)))
        (if (list? form)
            `(-> (,(first form) ,value ,@(rest form)) ,@(rest forms))
            `(-> (,form ,value) ,@(rest forms))))))

(defmacro ->> (value &rest forms)
  (if (nil? forms)
      value
      (let ((form (first forms)))
        (if (list? form)
            `(->> (,(first form) ,@(rest form) ,value) ,@(rest forms))
            `(->> (,form ,value) ,@(rest forms))))))

(defmacro as-> (value name &body forms)
  (if (nil? forms)
      value
      `(let ((,name ,value)) (as-> ,(first forms) ,name ,@(rest forms)))))

; CLOS-lite: a defclass/make-instance layer over the existing type/ref/
; object/new/method forms, in the spirit of the def* aliases and CL sequence
; functions above. Deliberate departures from real CLOS, tightened by what
; NFL doesn't have yet (see the tracker for the follow-up tickets):
;   - no :initform/:initarg — NFL has no object-field defaults, so every slot
;     is effectively a required make-instance argument.
;   - accessors are read-only — NFL's set! only assigns symbols, not object
;     fields, so :accessor cannot yet generate a setter; it is currently a
;     plain synonym for :reader.
;   - single inheritance only — a defclass superclass list may name at most
;     one parent; full CLOS multiple dispatch is tracked separately.
;   - defmethod stays the plain `method` alias defined above; CLOS-lite adds
;     no dispatch mechanism of its own.
;   - every slot carries an explicit Nim type, because Nim object fields
;     must be typed and NFL has no type-inference story for them.
;   - :accessor/:reader names become real `proc` names, so — unlike a
;     defclass/defmacro/defmacro-proc name itself, which only ever exists at
;     expansion time — they must be plain Nim identifiers (no hyphens);
;     `animalName`, not `animal-name`.

(defmacro-proc nfl-class-parent (supers)
  (if (nil? supers)
      'RootObj
      (if (nil? (rest supers))
          (first supers)
          (macro-error "defclass supports a single superclass; see the multiple-dispatch ticket"))))

(defmacro-proc nfl-slot-field (slot)
  (if (not (list? slot))
      (macro-error "defclass slot must be a list")
      (if (< (length slot) 2)
          (macro-error "defclass slot must be (name Type [options...])")
          (list (first slot) (nth slot 1)))))

(defmacro-proc nfl-slot-fields (slots)
  (if (nil? slots)
      '()
      (cons (nfl-slot-field (first slots)) (nfl-slot-fields (rest slots)))))

(defmacro-proc nfl-slot-option-key-ok? (key)
  (if (= key ':accessor) true (= key ':reader)))

(defmacro-proc nfl-validate-slot-options (opts)
  (if (nil? opts)
      nil
      (if (nil? (rest opts))
          (macro-error "defclass slot option missing its value")
          (if (nfl-slot-option-key-ok? (first opts))
              (if (symbol? (nth opts 1))
                  (nfl-validate-slot-options (rest (rest opts)))
                  (macro-error "defclass slot accessor/reader name must be a symbol"))
              (macro-error (string-append "defclass: unknown slot option " (symbol->string (first opts))))))))

(defmacro-proc nfl-slot-accessor-names (opts)
  (if (nil? opts)
      '()
      (cons (nth opts 1) (nfl-slot-accessor-names (rest (rest opts))))))

(defmacro-proc nfl-make-accessor (className fieldName fieldType accessorName)
  ; A literal `self` — not `(gensym "self")` — deliberately: `proc` params
  ; are not covered by the automatic hygiene-rename pass (see expand.nim's
  ; module comment on hygienicRename), and the backend emits ANY hygienic
  ; (gensym'd) symbol as a Nim `nskLet`, which cannot be used in param
  ; position at all. Safe without hygiene regardless: the accessor body
  ; only ever references its own `self`, in a proc that introduces its own
  ; fresh Nim scope, so there is no caller symbol for a literal name to
  ; capture or be captured by.
  `(proc ,accessorName ((self ,className)) (: ,fieldType) (. self ,fieldName)))

(defmacro-proc nfl-make-accessors-for-names (className fieldName fieldType names)
  (if (nil? names)
      '()
      (cons (nfl-make-accessor className fieldName fieldType (first names))
            (nfl-make-accessors-for-names className fieldName fieldType (rest names)))))

(defmacro-proc nfl-slot-accessors (className slot)
  (let ((fieldName (first slot))
        (fieldType (nth slot 1))
        (opts (rest (rest slot))))
    (nfl-validate-slot-options opts)
    (nfl-make-accessors-for-names className fieldName fieldType (nfl-slot-accessor-names opts))))

(defmacro-proc nfl-class-accessors (className slots)
  (if (nil? slots)
      '()
      (append (nfl-slot-accessors className (first slots)) (nfl-class-accessors className (rest slots)))))

(defmacro defclass (name supers slots)
  (let ((fields (nfl-slot-fields slots))
        (accessors (nfl-class-accessors name slots))
        (parent (nfl-class-parent supers)))
    `(block
       (type ,name (ref (object (of ,parent) ,@fields)))
       ,@accessors)))

(defmacro make-instance (className &rest inits)
  `(new ,className ,@inits))
