(defclass Animal ()
  ((name string :accessor animalName :initarg :nom)))

(defclass Dog (Animal)
  ((breed string :reader dogBreed :initarg :kind)))

(method speak {.base.} ((a Animal)) (: string) "...")
(method speak ((d Dog)) (: string) "woof")

(var rex (make-instance Dog (name "Rex") (breed "corgi")))
(var genericAnimal (make-instance Animal (name "Generic")))

(var rexName (animalName rex))
(var rexBreed (dogBreed rex))
(var rexSpeaks (speak rex))
(var genericSpeaks (speak genericAnimal))

; :accessor generates a setter as well as a getter (#75).
(set! (animalName rex) "Fido")
(var rexRenamed (animalName rex))

; :initform slot defaults (#78) — a non-zero default (string and int) that
; make-instance applies when a slot is omitted, alongside an inherited slot
; (name, from Animal) that can still be passed explicitly.
(defclass Cat (Animal)
  ((sound string :reader catSound :initform "meow")
   (lives int :accessor catLives :initform 9)))

(var whiskers (make-instance Cat (name "Whiskers")))
(var whiskersName (animalName whiskers))
(var whiskersSound (catSound whiskers))
(var whiskersLives (catLives whiskers))

; An explicit value still overrides its :initform.
(var tom (make-instance Cat (name "Tom") (sound "hiss") (lives 1)))
(var tomSound (catSound tom))
(var tomLives (catLives tom))

; :initarg (#85) — an external initializer name for a slot, alias not
; rename: an inherited slot's initarg (Animal's :nom, on Dog) still resolves
; even though defclass Dog never sees Animal's slots at macro-expand time;
; the field's own name (name/breed) still works too.
(var fido (make-instance Dog (nom "Fido") (kind "corgi")))
(var fidoName (animalName fido))
(var fidoBreed (dogBreed fido))

(var buddy (make-instance Dog (name "Buddy") (breed "lab")))
(var buddyName (animalName buddy))
(var buddyBreed (dogBreed buddy))

; :initarg composes with :initform — the initarg is just another spelling
; for the slot, so omitting it still falls back to the slot's :initform.
(defclass Bird (Animal)
  ((song string :reader birdSong :initarg :tune :initform "tweet")))

(var tweety (make-instance Bird (nom "Tweety")))
(var tweetySong (birdSong tweety))

(var robin (make-instance Bird (nom "Robin") (tune "chirp")))
(var robinSong (birdSong robin))
