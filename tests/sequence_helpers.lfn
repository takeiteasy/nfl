(var nums (@ [1 2 3 4]))
(var words (@ ["a" "bb" "ccc"]))

(var firstValue (first nums))
(var restValues (rest nums))
(var emptyValues (empty? (@ [])))
(var appendedValues (append nums (@ [5 6])))

(var mappedValues
  (map nums (do ((x int)) (* x 2))))

(var mappedWithCapture
  (let ((offset 10))
    (map nums (do ((x int)) (+ x offset)))))

(var filteredValues
  (filter nums (do ((x int)) (< x 4))))

(var foldedLeft
  (foldl nums 0 (do ((acc int) (x int)) (- acc x))))

(var foldedRight
  (foldr nums 0 (do ((x int) (acc int)) (- x acc))))

(var mappedStrings
  (map words (do ((s string)) (. s len))))

; CL-style sequence functions
(var madeArray (make-array 3 9))
(var lengthValue (length nums))
(var reversedValues (reverse nums))
(var sortedValues (sort (@ [3 1 4 1 5])))
(var mapcarValues (mapcar nums (do ((x int)) (* x 3))))
(var reducedValue (reduce nums 0 (do ((acc int) (x int)) (+ acc x))))
(var removedIfValues (remove-if nums (do ((x int)) (< x 3))))
(var removedIfNotValues (remove-if-not nums (do ((x int)) (< x 3))))
(var countIfValue (count-if nums (do ((x int)) (< x 3))))
(var someValue (some nums (do ((x int)) (== x 3))))
(var everyValue (every nums (do ((x int)) (< x 10))))
(var positionValue (position nums 3))
(var eltValue (elt nums 1))
(var arefValue (aref nums 1))
(var subseqValue (subseq nums 1 3))
(var subseqToEndValue (subseq nums 2))
