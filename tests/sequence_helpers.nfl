(var nums (@ [1 2 3 4]))
(var words (@ ["a" "bb" "ccc"]))

(var firstValue (first nums))
(var restValues (rest nums))
(var emptyValues (empty? (@ [])))
(var appendedValues (append nums (@ [5 6])))

(var mappedValues
  (map nums (do ((x int64)) (* x 2))))

(var mappedWithCapture
  (let ((offset 10))
    (map nums (do ((x int64)) (+ x offset)))))

(var filteredValues
  (filter nums (do ((x int64)) (< x 4))))

(var foldedLeft
  (foldl nums 0 (do ((acc int64) (x int64)) (- acc x))))

(var foldedRight
  (foldr nums 0 (do ((x int64) (acc int64)) (- x acc))))

(var mappedStrings
  (map words (do ((s string)) (. s len))))
