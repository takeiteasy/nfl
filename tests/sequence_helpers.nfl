(var nums (@ [1 2 3 4]))
(var words (@ ["a" "bb" "ccc"]))

(var firstValue (first nums))
(var restValues (rest nums))
(var emptyValues (empty? (@ [])))
(var appendedValues (append nums (@ [5 6])))

(var mappedValues
  (map nums (do ((x int)) (* x 2))))

(var mappedWithCapture
  (let ((offset 10))
    (map nums (do ((x int)) (+ x offset)))))

(var filteredValues
  (filter nums (do ((x int)) (< x 4))))

(var foldedLeft
  (foldl nums 0 (do ((acc int) (x int)) (- acc x))))

(var foldedRight
  (foldr nums 0 (do ((x int) (acc int)) (- x acc))))

(var mappedStrings
  (map words (do ((s string)) (. s len))))
