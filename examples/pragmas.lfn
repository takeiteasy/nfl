; Demonstrate Nim pragma annotations in LFN.
;
; Pragmas are written as `{.name.}` or `{.name1, name2.}` and placed
; immediately after the declaration name they annotate.
;
; Two pragma forms are supported:
;   Marker pragmas:  {.inline.}            — no argument
;   Value pragmas:   {.importc: "name".}   — key: value pair (colon syntax)
; Both forms may be mixed freely: {.inline, importc: "foo".}

; --- Marker pragmas (no argument) ---

; Proc pragma — {.discardable.} lets callers ignore the return value.
(proc makeAnswer {.discardable.} () (: int)
  42)

; Proc pragma with return type.
(proc addFast {.inline.} ((x int) (y int)) (: int)
  (+ x y))

; Multiple marker pragmas on a proc.
(proc purePlus {.inline, noSideEffect.} ((x int) (y int)) (: int)
  (+ x y))

; Pragma composes with the `*` export marker.
(proc doubled* {.inline.} ((x int)) (: int)
  (* x 2))

; Pragma on a type declaration.
(type Point {.bycopy.}
  (object
    (x int)
    (y int)))

; Pragma on object fields.
(type Tagged
  (object
    (value int)
    (label {.used.} string)))

; Pragma on var declaration.
(var counter {.used.} 0)

; Pragma on const.
(const maxItems {.used.} 100)

; --- Value pragmas (key: value) ---

; {.raises: [].} declares that a proc raises no exceptions.
(proc safeAdd {.raises: [].} ((x int) (y int)) (: int)
  (+ x y))

; {.deprecated: "msg".} marks a proc as deprecated with a message.
(proc oldDouble {.deprecated: "use doubled instead".} ((x int)) (: int)
  (* x 2))

; Marker and value pragmas mixed on the same declaration.
(proc fastSafe {.inline, raises: [].} ((x int) (y int)) (: int)
  (+ x y))

; --- Local binding pragmas ---

; Pragmas can annotate local let/var bindings inside expressions.
; The pragma sits between the binding target and the value.
(var letResult
  (let ((x {.used.} 10))
    x))

; Typed local binding with a pragma.
(var typedLetResult
  (let (((n int) {.used.} 5))
    n))

(echo (addFast 3 4))
(echo (doubled 5))
(echo (safeAdd 10 20))
(echo letResult)
(echo typedLetResult)
