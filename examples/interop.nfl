(import std/strutils)
(import std/os)
(import std/math)

(proc shout ((name string)) (: string)
  (name.toUpperAscii))

(proc hypotenuse ((a float) (b float)) (: float)
  (sqrt (+ (* a a) (* b b))))

(var names (@ ["nfl" "macro" "nim"]))
(var currentDir (getCurrentDir))
(var baseName (lastPathPart currentDir))

(echo (shout "hello"))
(echo (shout baseName))
(echo (hypotenuse 3.0 4.0))
(echo
  (let (((index int) 1))
    (|[]| names index)))
(echo (. names len))
