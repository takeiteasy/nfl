; Demonstrates for loops, while loops, break, and continue.

; Sum elements of a sequence with for.
(var nums [1 2 3 4 5])
(var ((total 0))
  (for (n nums)
    (set! total (+ total n)))
  (echo "Sum: " total))

; Iterate over a range using the `..` operator.
(var ((rangeTotal 0))
  (for (i (.. 1 5))
    (set! rangeTotal (+ rangeTotal i)))
  (echo "Range sum: " rangeTotal))

; Multi-variable iteration using pairs.
(var words ["apple" "banana" "cherry"])
(for ((idx word) (. words pairs))
  (echo idx ": " word))

; while loop — count down from 3 to 1.
(var ((n 3))
  (while (> n 0)
    (echo "tick " n)
    (set! n (- n 1))))

; break exits a while loop early.
(var ((i 0))
  (while true
    (if (>= i 3) (break) nil)
    (set! i (+ i 1)))
  (echo "stopped at: " i))

; continue skips the rest of the body for the current iteration.
; Prints only odd values: 1, 3, 5.
(var ((k 0))
  (while (< k 5)
    (set! k (+ k 1))
    (if (== 0 (mod k 2))
        (continue)
        (echo "odd: " k))))
