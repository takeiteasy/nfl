(defclass Animal ()
  ((name string :accessor animalName :initarg :nom)))

(defclass Dog (Animal)
  ((breed string :reader dogBreed)))

(method speak {.base.} ((a Animal)) (: string) "...")
(method speak ((d Dog)) (: string) "woof")

(var rex (make-instance Dog (name "Rex") (breed "corgi")))
(echo (animalName rex) " says " (speak rex))

; :accessor generates a setter as well as a getter — :reader stays getter-only.
(set! (animalName rex) "Fido")
(echo "renamed to " (animalName rex))

; :initform — a slot default make-instance applies when the slot is omitted.
; An inherited slot (name, from Animal) can still be passed explicitly.
(defclass Cat (Animal)
  ((sound string :reader catSound :initform "meow")))

(var whiskers (make-instance Cat (name "Whiskers")))
(echo (animalName whiskers) " says " (catSound whiskers))

; :initarg — a distinct external initializer name for a slot. It's an alias,
; not a rename: the slot's own field name still works too, and — since
; make-instance resolves initargs against the whole inheritance chain — an
; inherited slot's initarg (Animal's :nom) still resolves from Dog, even
; though defclass Dog never sees Animal's slots at its own expansion time.
(var fido (make-instance Dog (nom "Fido") (breed "corgi")))
(echo (animalName fido) " says " (speak fido))
