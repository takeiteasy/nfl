; Demonstrates Nim `func` and `converter` definitions from LFN.
; `func` is shorthand for a side-effect-free `proc` (`{.noSideEffect.}`).
; `converter` defines a callable conversion from one type to another.
; Converters must declare exactly one parameter and an explicit return
; (target) type.

; A plain func — doubles an int with no side effects.
(func double ((x int)) (: int)
  (* x 2))

; An exported generic func — the [T] parameter follows the same pattern
; as proc/template/iterator/type.
(func identity* [T] ((x T)) (: T)
  x)

; A converter from int to float.
(converter toFloat ((x int)) (: float)
  (float x))

(echo "double(21) = " (double 21))
(echo "identity(7) = " (identity 7))

; A parameter default — a trailing default value fills the parameter when
; the caller omits it. Unlike an object field default, a parameter default
; has no compile-time-evaluable restriction: any expression works, and can
; reference an earlier parameter.
(func greet ((name string "world")) (: string)
  (& "hi " name))
(echo "greet() = " (greet))
(echo "greet(\"Ada\") = " (greet "Ada"))

; The converter applies implicitly wherever a float is expected — no
; explicit call needed, same as plain Nim.
(proc addHalf ((f float)) (: float)
  (+ f 0.5))

(var three 3)
(echo "addHalf(three) = " (addHalf three))
; An explicit call still works too.
(echo "toFloat(three) + 0.5 = " (+ (toFloat three) 0.5))
