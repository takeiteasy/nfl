; Demonstrates for loops, while loops, break, and continue.

; Sum elements of a sequence with for.
(var nums [1 2 3 4 5])
(var ((total 0))
  (for (n nums)
    (set! total (+ total n)))
  (echo "Sum: " total))

; Iterate over a range using the `..` operator.
(var ((rangeTotal 0))
  (for (i (.. 1 5))
    (set! rangeTotal (+ rangeTotal i)))
  (echo "Range sum: " rangeTotal))

; Multi-variable iteration using pairs.
(var words ["apple" "banana" "cherry"])
(for ((idx word) (. words pairs))
  (echo idx ": " word))

; while loop — count down from 3 to 1.
(var ((n 3))
  (while (> n 0)
    (echo "tick " n)
    (set! n (- n 1))))

; break exits a while loop early.
(var ((i 0))
  (while true
    (if (>= i 3) (break) nil)
    (set! i (+ i 1)))
  (echo "stopped at: " i))

; continue skips the rest of the body for the current iteration.
; Prints only odd values: 1, 3, 5.
(var ((k 0))
  (while (< k 5)
    (set! k (+ k 1))
    (if (== 0 (mod k 2))
        (continue)
        (echo "odd: " k))))

; A named block + break-from exits a specific enclosing block — including
; one wrapping a loop — with a value, rather than just the innermost loop.
(proc firstOver ((xs [seq int]) (limit int)) (: int)
  (block :search
    (for (x xs)
      (if (> x limit) (break-from :search x) nil))
    -1))
(echo "first over 3: " (firstOver (@ [1 2 3 9 4]) 3))
(echo "first over 100: " (firstOver (@ [1 2 3]) 100))

; A labelled loop lets a nested loop's break/continue target it directly,
; rather than only ever affecting the innermost loop.
(var ((i 0))
  (while :outer (< i 3)
    (var ((j 0))
      (while (< j 3)
        (if (and (== i 1) (== j 1)) (break :outer) nil)
        (echo "pair " i " " j)
        (set! j (+ j 1))))
    (set! i (+ i 1)))
  (echo "stopped labelled loop at i=" i))

; A labelled continue restarts the labelled loop directly, skipping both
; the rest of the inner loop and the rest of the outer loop's own body.
(var ((i 0) (acc 0))
  (while :outer (< i 3)
    (set! i (+ i 1))
    (var ((j 0))
      (while (< j 3)
        (if (== j 1) (continue :outer) nil)
        (set! acc (+ acc 1))
        (set! j (+ j 1))))
    (set! acc (+ acc 100)))
  (echo "labelled continue total: " acc))
