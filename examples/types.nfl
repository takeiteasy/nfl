(type Person
  (object
    (name string)
    (age int)))

(proc personAge ((p Person)) (: int)
  (. p age))

(var ada (new Person
  (name "Ada")
  (age 36)))

(echo "person age: " (personAge ada))
(echo "person age by named call: " (personAge (: p ada)))

; object field defaults — a trailing default value fills the field when a
; constructor call (new/make-instance) omits it; an explicit value overrides
; it. Field defaults must be compile-time-evaluable Nim expressions.
(type Config
  (object
    (host string "localhost")
    (port int 8080)))
(var defaultConfig (new Config))
(var customConfig (new Config (port 9090)))
(echo "default config: " (. defaultConfig host) ":" (. defaultConfig port))
(echo "custom config: " (. customConfig host) ":" (. customConfig port))

; distinct — newtype wrapper: prevents accidental mixing of units.
(type Metres (distinct float))
(proc toMetres ((x float)) (: Metres) (Metres x))
(var dist (toMetres 42.0))
(echo "distance: " (float dist) "m")

; tuple — structural record type usable in proc signatures.
; tuple-new constructs a named tuple by field.
(type Vec2 (tuple (x float) (y float)))
(proc getX ((v Vec2)) (: float) (. v x))
(var vec (tuple-new Vec2 (x 1.0) (y 2.0)))
(echo "vec.x: " (getX vec))

; ref object — heap-allocated with garbage collection.
(type Node (ref (object (val int))))
(proc mkNode ((v int)) (: Node) (new Node (val v)))
(var n (mkNode 99))
(echo "node value: " (. n val))

; enum — ordinal type with implicit or explicit values, freely mixed.
(type ErrCode
  (enum (Ok 0) (NotFound 404) (ServerError 500)))
(echo "NotFound ordinal: " (ord NotFound))
(echo "ServerError ordinal: " (ord ServerError))

; object inheritance — shared base type with dynamic dispatch.
(type Animal (ref (object (of RootObj) (name string))))
(type Dog    (ref (object (of Animal))))
(method speak {.base.} ((a Animal)) (: string) "...")
(method speak ((d Dog)) (: string) "woof")
(var dog (new Dog (name "Rex")))
(echo (. dog name) " says: " (speak dog))

; case object — a case-discriminated variant record, mirroring Nim's own.
; Plain fields, then one case clause, then of/else branches to the end.
(type ShapeKind (enum skCircle skRect skPoint))
(type Shape
  (object
    (id int)
    (case kind ShapeKind)
    (of skCircle (radius float))
    (of [skRect] (width float) (height float))
    (of skPoint)))

(proc area ((s Shape)) (: float)
  (case (. s kind)
    (of skCircle (* 3.14159 (* (. s radius) (. s radius))))
    (of skRect (* (. s width) (. s height)))
    (of skPoint 0.0)))

(var circle (new Shape (id 1) (kind skCircle) (radius 2.0)))
(var square (new Shape (id 2) (kind skRect) (width 3.0) (height 4.0)))
(echo "circle area: " (area circle))
(echo "square area: " (area square))
