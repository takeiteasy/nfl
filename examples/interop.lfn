(import std/strutils)
(import std/os)
(import std/math)

(proc shout ((name string)) (: string)
  (name.toUpperAscii))

(proc hypotenuse ((a float) (b float)) (: float)
  (sqrt (+ (* a a) (* b b))))

; A distinct wrapper type plus a converter to its underlying Nim type — the
; concrete interop shape a converter is for: values arrive as a domain type
; (`Meters`) but the stdlib proc (`hypotenuse`, via `sqrt`) expects `float`.
; The converter applies implicitly at the call site, same as plain Nim.
(type Meters (distinct float))

(converter metersToFloat ((m Meters)) (: float)
  (float m))

(proc hypotenuseMeters ((a Meters) (b Meters)) (: float)
  (hypotenuse a b))    ; `a`/`b` convert to `float` implicitly

; Custom operator proc (#29) — `|op|` names a proc after the operator
; symbol; a trailing `*` exports it. `+*` here defines an exported `+`
; overload for `Meters`, callable both from LFN (prefix, like any call) and
; infix from plain Nim.
(proc +* ((a Meters) (b Meters)) (: Meters)
  (Meters (+ (float a) (float b))))

(var names (@ ["lfn" "macro" "nim"]))
(var currentDir (getCurrentDir))
(var baseName (lastPathPart currentDir))

(echo (shout "hello"))
(echo (shout baseName))
(echo (hypotenuse 3.0 4.0))
(echo (hypotenuseMeters (Meters 3.0) (Meters 4.0)))
(echo (float (+ (Meters 3.0) (Meters 4.0))))
(echo
  (let (((index int) 1))
    (|[]| names index)))
(echo (. names len))
