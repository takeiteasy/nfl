; nil Standard Library
; Non-recursive utilities built from minimal primitives: if, let, lambda, progn, set!, car, cdr, cons, null?
; Recursive/higher-order functions are built-in special forms or Nim runtime procs

(define t true)

(define (pair? x)
  (if (null? x) false t))

(define (atom? x)
  (if (pair? x) false t))

(define (caar x) (car (car x)))
(define (cadr x) (car (cdr x)))
(define (cdar x) (cdr (car x)))
(define (cddr x) (cdr (cdr x)))

(define (caaar x) (car (car (car x))))
(define (caadr x) (car (car (cdr x))))
(define (cadar x) (car (cdr (car x))))
(define (caddr x) (car (cdr (cdr x))))
(define (cdaar x) (cdr (car (car x))))
(define (cdadr x) (cdr (car (cdr x))))
(define (cddar x) (cdr (cdr (car x))))
(define (cdddr x) (cdr (cdr (cdr x))))

(define (identity x) x)

(define (zero? x) (= x 0))
(define (positive? x) (> x 0))
(define (negative? x) (< x 0))
(define (even? x) (zero? (mod x 2)))
(define (odd? x) (!= (mod x 2) 0))
